# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

# CRO Ireland API (if required)
CRO_API_KEY=your_key_here

# GDELT (no key needed for public API, but note rate limits)
GDELT_RATE_LIMIT=60  # requests per minute

# MLflow tracking server (local by default)
MLFLOW_TRACKING_URI=./mlruns

# Project paths (override defaults if needed)
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
